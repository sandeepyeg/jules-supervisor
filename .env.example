PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jules_supervisor
DB_USER=your_db_user
DB_PASS=your_db_password

# Jules API
JULES_API_KEY=your_jules_api_key
JULES_BASE_URL=https://jules.googleapis.com/v1alpha
JULES_REPO_SOURCE=sources/github/your_username_or_org/your_repo_name

# GitHub
GITHUB_TOKEN=ghp_xxxxx
GITHUB_OWNER=your_username_or_org
GITHUB_REPO=your_repo_name

# Gemini Flash (Google AI Studio key)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-latest

# DeepSeek via Kilo Gateway
KILO_API_KEY=your_kilo_api_key
KILO_BASE_URL=https://api.kilo.ai/v1
KILO_MODEL=deepseek-v4-pro

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_personal_chat_id
# Optional: Set this to use Webhook mode. If omitted, bot defaults to long-polling mode.
# TELEGRAM_WEBHOOK_URL=https://yourdomain.com

# Portal security
PORTAL_SECRET=choose_a_random_string

# Confidence threshold (0-10). Below this, escalate to Telegram instead of auto-answering
AI_CONFIDENCE_THRESHOLD=7

# Polling interval in milliseconds
POLL_INTERVAL_MS=30000

# Telegram reminder interval in milliseconds
TELEGRAM_REMINDER_MS=300000
