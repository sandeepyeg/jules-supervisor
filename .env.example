PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jules_supervisor
DB_USER=your_db_user
DB_PASS=your_db_password

# Jules API
JULES_API_KEY=your_jules_api_key
JULES_BASE_URL=https://jules.googleapis.com/v1alpha
JULES_REPO_SOURCE=sources/github/your_username_or_org/your_repo_name

# GitHub
GITHUB_TOKEN=ghp_xxxxx
GITHUB_OWNER=your_username_or_org
GITHUB_REPO=your_repo_name

# Gemini Flash (Google AI Studio key)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-latest

# OpenRouter (DeepSeek)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-chat

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_personal_chat_id
# Optional: Set this to use Webhook mode. If omitted, bot defaults to long-polling mode.
# TELEGRAM_WEBHOOK_URL=https://yourdomain.com

# Portal security
PORTAL_SECRET=choose_a_random_string

# Confidence threshold (0-10). Below this, escalate to Telegram instead of auto-answering
AI_CONFIDENCE_THRESHOLD=8

# Polling interval in milliseconds
POLL_INTERVAL_MS=30000

# Telegram reminder interval in milliseconds
TELEGRAM_REMINDER_MS=300000

# Model Routing & Provider Configurations
PRIMARY_SUPERVISOR_PROVIDER=google
PRIMARY_SUPERVISOR_MODEL=gemini-3.1-flash-lite
BACKUP_SUPERVISOR_PROVIDER=openrouter
BACKUP_SUPERVISOR_MODEL=deepseek/deepseek-chat
STRONG_REVIEW_PROVIDER=google
STRONG_REVIEW_MODEL=gemini-3.5-flash

# Safe Merging Policies
TASK_AUTO_MERGE_TO_PHASE_BRANCH=false
NEVER_MERGE_TO_MAIN=true
HUMAN_APPROVAL_REQUIRED_FOR_MAIN=true
CREATE_FINAL_DRAFT_PR=false

# PR Diff and Review Limits
MAX_PR_DIFF_CHARS=120000
PR_REVIEW_CHUNK_CHARS=20000
GEMINI_DAILY_FREE_CALL_BUDGET=450

